<mxfile host="app.diagrams.net" agent="pitwall" version="24.7.17">
  <diagram name="1. Where am I" id="zones">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="pitwall: which keys work depends on WHICH PANE HAS FOCUS" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232136;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="This is the thing nothing on screen tells you. Three zones, three key sets. The arrows are how you move between them." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#575279;" vertex="1" parent="1">
          <mxGeometry x="360" y="58" width="880" height="24" as="geometry" />
        </mxCell>

        <mxCell id="start" value="&lt;b&gt;.\Start-Pitwall.ps1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232136;strokeColor=#232136;fontColor=#e0def4;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="opens" value="Opens ready to work: the agent is already running on the left, the file panel is already open on the right.&#10;You do not have to type or split anything." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf4ed;strokeColor=#907aa9;fontColor=#575279;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="170" width="440" height="54" as="geometry" />
        </mxCell>
        <mxCell id="e_start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232136;strokeWidth=2;" edge="1" parent="1" source="start" target="opens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="zoneA" value="ZONE 1: AGENT PANE (Claude Code)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#faf4ed;strokeColor=#3e8fb0;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;swimlaneFillColor=#faf4ed;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="zoneAstyle" value="" style="text;html=1;" vertex="1" parent="zoneA">
          <mxGeometry x="0" y="0" width="1" height="1" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Here you just TALK TO THE AGENT.&#10;Normal typing. Claude Code's own keys apply." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2e9e1;strokeColor=none;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="zoneA">
          <mxGeometry x="15" y="48" width="390" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;shift+enter&lt;/b&gt;&#9;newline without sending&#10;&lt;b&gt;esc&lt;/b&gt;&#9;&#9;interrupt the agent&#10;&lt;b&gt;ctrl+c&lt;/b&gt;&#9;&#9;passes through to the agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="zoneA">
          <mxGeometry x="15" y="104" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&#9888; esc here interrupts the AGENT.&#10;In Zone 2 the same key CLOSES the panel.&#10;Same key, different meaning. Watch the focus." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0ed;strokeColor=#eb6f92;fontColor=#b4637a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="zoneA">
          <mxGeometry x="15" y="192" width="390" height="60" as="geometry" />
        </mxCell>

        <mxCell id="zoneB" value="ZONE 2: FILE VIEWER (the right panel)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#faf4ed;strokeColor=#907aa9;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="290" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="SINGLE KEYS. No ctrl, no prefix.&#10;This is where you read what the agent did." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2e9e1;strokeColor=none;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="zoneB">
          <mxGeometry x="15" y="48" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;]&lt;/b&gt; &lt;b&gt;[&lt;/b&gt;&#9;next / previous CHANGED file  &#8592; start here&#10;&lt;b&gt;c&lt;/b&gt;&#9;show only changed files&#10;&lt;b&gt;d&lt;/b&gt;&#9;working-tree diffs&#10;&lt;b&gt;D&lt;/b&gt;&#9;cycle diff style: unified / side by side / plain&#10;&lt;b&gt;enter&lt;/b&gt;&#9;open file, or expand folder&#10;&lt;b&gt;tab&lt;/b&gt;&#9;move between tree and content&#10;&lt;b&gt;f&lt;/b&gt;&#9;fuzzy find a file by name&#10;&lt;b&gt;/&lt;/b&gt; then &lt;b&gt;n&lt;/b&gt; &lt;b&gt;N&lt;/b&gt;&#9;search in file, next / previous hit&#10;&lt;b&gt;z&lt;/b&gt;&#9;hide the tree, content fills the pane&#10;&lt;b&gt;y&lt;/b&gt; &lt;b&gt;Y&lt;/b&gt;&#9;copy relative / absolute path&#10;&lt;b&gt;?&lt;/b&gt;&#9;the viewer's own full key list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="zoneB">
          <mxGeometry x="15" y="100" width="390" height="230" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;A&lt;/b&gt; annotate a range, then &lt;b&gt;y&lt;/b&gt; to copy it.&#10;Paste into the agent: it gets the file, the lines and&#10;your comment, without you describing where." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f3;strokeColor=#3e8fb0;fontColor=#286983;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="zoneB">
          <mxGeometry x="15" y="340" width="390" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&#9888; &lt;b&gt;esc&lt;/b&gt; and &lt;b&gt;q&lt;/b&gt; CLOSE this panel. esc cannot be remapped.&#10;It is not lost: &lt;b&gt;ctrl+b f&lt;/b&gt; brings it straight back." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0ed;strokeColor=#eb6f92;fontColor=#b4637a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="zoneB">
          <mxGeometry x="15" y="404" width="390" height="48" as="geometry" />
        </mxCell>

        <mxCell id="zoneC" value="ZONE 3: EDITOR (micro)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#faf4ed;strokeColor=#f6c177;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="290" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Opens in its OWN pane beside the viewer,&#10;so the file tree stays on screen." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2e9e1;strokeColor=none;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="zoneC">
          <mxGeometry x="15" y="48" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;ctrl+s&lt;/b&gt;&#9;save&#10;&lt;b&gt;ctrl+q&lt;/b&gt;&#9;quit, the pane closes itself&#10;&lt;b&gt;ctrl+z&lt;/b&gt;&#9;undo&#10;&lt;b&gt;ctrl+f&lt;/b&gt;&#9;find&#10;&lt;b&gt;ctrl+g&lt;/b&gt;&#9;micro's own help" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="zoneC">
          <mxGeometry x="15" y="100" width="390" height="112" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="micro repeats these along its own bottom row.&#10;If you are ever unsure in here, look down." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6e3;strokeColor=#f6c177;fontColor=#8c7851;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="zoneC">
          <mxGeometry x="15" y="224" width="390" height="44" as="geometry" />
        </mxCell>

        <mxCell id="eAB" value="ctrl+b l&#10;(focus right)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#907aa9;strokeWidth=3;fontColor=#907aa9;fontSize=12;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="zoneA" target="zoneB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBA" value="ctrl+b h&#10;(focus left)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3e8fb0;strokeWidth=3;fontColor=#3e8fb0;fontSize=12;fontStyle=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="zoneB" target="zoneA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBC" value="e&#10;(edit selected file)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f6c177;strokeWidth=3;fontColor=#8c7851;fontSize=12;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="zoneB" target="zoneC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eCB" value="ctrl+q&#10;(pane closes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#907aa9;strokeWidth=3;fontColor=#907aa9;fontSize=12;fontStyle=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="zoneC" target="zoneB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="anywhere" value="ANYWHERE: the ctrl+b prefix. Hold ctrl, tap b, release, then tap the next key. Works no matter which zone you are in." style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#faf4ed;strokeColor=#232136;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="1480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;ctrl+b i&lt;/b&gt;&#9;&#9;the key card (all of this, on screen)&#10;&lt;b&gt;ctrl+b ?&lt;/b&gt;&#9;&#9;herdr's own generated key list&#10;&lt;b&gt;ctrl+b f&lt;/b&gt;&#9;&#9;file panel: open / close&#10;&lt;b&gt;ctrl+b z&lt;/b&gt;&#9;&#9;zoom the focused pane full screen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="anywhere">
          <mxGeometry x="15" y="48" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;ctrl+b h j k l&lt;/b&gt;&#9;focus pane left / down / up / right&#10;&lt;b&gt;ctrl+b tab&lt;/b&gt;&#9;&#9;next pane&#10;&lt;b&gt;ctrl+b b&lt;/b&gt;&#9;&#9;show / hide the agent sidebar&#10;&lt;b&gt;ctrl+b r&lt;/b&gt;&#9;&#9;resize mode, then arrows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="anywhere">
          <mxGeometry x="380" y="48" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="&lt;b&gt;ctrl+b c&lt;/b&gt;&#9;&#9;new tab&#10;&lt;b&gt;ctrl+b n&lt;/b&gt; / &lt;b&gt;p&lt;/b&gt;&#9;next / previous tab&#10;&lt;b&gt;ctrl+b 1..9&lt;/b&gt;&#9;jump to tab by number&#10;&lt;b&gt;ctrl+b x&lt;/b&gt;&#9;&#9;close the focused pane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="anywhere">
          <mxGeometry x="745" y="48" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="&lt;b&gt;ctrl+b alt+g&lt;/b&gt;&#9;lazygit, over everything&#10;&lt;b&gt;ctrl+b w&lt;/b&gt;&#9;&#9;workspace picker&#10;&lt;b&gt;ctrl+b shift+n&lt;/b&gt;&#9;new workspace (another project)&#10;&lt;b&gt;ctrl+b q&lt;/b&gt;&#9;&#9;detach; the session keeps running" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="anywhere">
          <mxGeometry x="1110" y="48" width="355" height="100" as="geometry" />
        </mxCell>

        <mxCell id="stuck" value="&lt;b&gt;STUCK? Two keys get you out of anything.&lt;/b&gt;&#10;&lt;b&gt;ctrl+b i&lt;/b&gt; shows every key.&#160;&#160;&#160;&lt;b&gt;ctrl+b f&lt;/b&gt; brings the panel back.&#160;&#160;&#160;At a plain PowerShell prompt? Press &lt;b&gt;enter&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232136;strokeColor=#c4a7e7;strokeWidth=3;fontColor=#e0def4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="1040" width="880" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2. I want to..." id="usecases">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="&quot;I want to...&quot; &#8594; press this" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232136;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Read left to right. Nothing here needs the mouse, and nothing here needs the documentation." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#575279;" vertex="1" parent="1">
          <mxGeometry x="400" y="58" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="THE DAILY LOOP" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#faf4ed;strokeColor=#3e8fb0;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="1480" height="230" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="1. Ask the agent&#10;&#10;It is already running.&#10;&lt;b&gt;ctrl+b h&lt;/b&gt; to focus it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e8fb0;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="loop">
          <mxGeometry x="20" y="50" width="255" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="2. See what it changed&#10;&#10;&lt;b&gt;ctrl+b l&lt;/b&gt; focus the panel&#10;&lt;b&gt;]&lt;/b&gt; jump to next changed file&#10;&lt;b&gt;[&lt;/b&gt; go back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e8fb0;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="loop">
          <mxGeometry x="310" y="50" width="255" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="3. Too narrow to read?&#10;&#10;&lt;b&gt;ctrl+b z&lt;/b&gt; zoom full screen&#10;&lt;b&gt;ctrl+b z&lt;/b&gt; again to go back&#10;&lt;b&gt;D&lt;/b&gt; try side-by-side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e8fb0;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="loop">
          <mxGeometry x="600" y="50" width="255" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="4. Something is wrong&#10;&#10;&lt;b&gt;A&lt;/b&gt; annotate the lines&#10;&lt;b&gt;y&lt;/b&gt; copy it&#10;paste into the agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e8fb0;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="loop">
          <mxGeometry x="890" y="50" width="255" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="5. Fix it yourself&#10;&#10;&lt;b&gt;e&lt;/b&gt; edit beside the tree&#10;&lt;b&gt;ctrl+s&lt;/b&gt; save&#10;&lt;b&gt;ctrl+q&lt;/b&gt; back to the diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e8fb0;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="loop">
          <mxGeometry x="1180" y="50" width="255" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3e8fb0;strokeWidth=2;" edge="1" parent="loop" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3e8fb0;strokeWidth=2;" edge="1" parent="loop" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3e8fb0;strokeWidth=2;" edge="1" parent="loop" source="l3" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3e8fb0;strokeWidth=2;" edge="1" parent="loop" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="find" value="FINDING THINGS" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#faf4ed;strokeColor=#907aa9;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="720" height="290" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&quot;Which files are in this project?&quot;&#9;&#8594;&#9;the panel IS the tree. &lt;b&gt;ctrl+b l&lt;/b&gt; to focus it.&#10;&#10;&quot;Open a file by name&quot;&#9;&#9;&#8594;&#9;&lt;b&gt;f&lt;/b&gt; then type&#10;&#10;&quot;Only what changed&quot;&#9;&#9;&#8594;&#9;&lt;b&gt;c&lt;/b&gt;&#10;&#10;&quot;Search inside this file&quot;&#9;&#9;&#8594;&#9;&lt;b&gt;/&lt;/b&gt; then &lt;b&gt;n&lt;/b&gt; / &lt;b&gt;N&lt;/b&gt;&#10;&#10;&quot;Jump to a line&quot;&#9;&#9;&#9;&#8594;&#9;&lt;b&gt;:&lt;/b&gt;&#10;&#10;&quot;Which agents are running?&quot;&#9;&#8594;&#9;&lt;b&gt;ctrl+b b&lt;/b&gt; expands the sidebar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="find">
          <mxGeometry x="20" y="50" width="680" height="220" as="geometry" />
        </mxCell>

        <mxCell id="git" value="GIT, AND MORE PROJECTS" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#faf4ed;strokeColor=#f6c177;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="370" width="720" height="290" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&quot;Stage, commit, discard&quot;&#9;&#8594;&#9;&lt;b&gt;ctrl+b alt+g&lt;/b&gt; opens lazygit over everything&#10;&#10;&quot;Work on another project&quot;&#9;&#8594;&#9;&lt;b&gt;ctrl+b shift+n&lt;/b&gt; new workspace&#10;&#10;&quot;Switch between projects&quot;&#9;&#8594;&#9;&lt;b&gt;ctrl+b w&lt;/b&gt; workspace picker&#10;&#10;&quot;A second thing side by side&quot;&#9;&#8594;&#9;&lt;b&gt;ctrl+b c&lt;/b&gt; new tab, &lt;b&gt;ctrl+b 1..9&lt;/b&gt; to jump&#10;&#10;&quot;A throwaway branch&quot;&#9;&#9;&#8594;&#9;&lt;b&gt;ctrl+b shift+g&lt;/b&gt; new git worktree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfdad9;fontColor=#575279;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="git">
          <mxGeometry x="20" y="50" width="680" height="220" as="geometry" />
        </mxCell>

        <mxCell id="oops" value="WHEN SOMETHING GOES WRONG" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#faf4ed;strokeColor=#eb6f92;strokeWidth=3;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="1480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&quot;The panel disappeared&quot;&#10;&#8594; &lt;b&gt;ctrl+b f&lt;/b&gt;&#10;&#10;You pressed esc or q inside it.&#10;esc cannot be remapped away." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6f92;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="oops">
          <mxGeometry x="20" y="50" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&quot;I am at a plain PowerShell&#10;prompt and everything is gone&quot;&#10;&#8594; press &lt;b&gt;enter&lt;/b&gt;&#10;&#10;It reopens. Type &lt;b&gt;q&lt;/b&gt; + enter if&#10;you actually wanted a shell." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6f92;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="oops">
          <mxGeometry x="390" y="50" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&quot;I forgot the key&quot;&#10;&#8594; &lt;b&gt;ctrl+b i&lt;/b&gt;&#10;&#10;The card covers all three zones.&#10;&lt;b&gt;q&lt;/b&gt; closes it.&#10;&lt;b&gt;ctrl+b ?&lt;/b&gt; for herdr's own list." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6f92;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="oops">
          <mxGeometry x="760" y="50" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&quot;Nothing responds to my keys&quot;&#10;&#8594; check WHICH PANE has focus&#10;&#10;&lt;b&gt;ctrl+b h j k l&lt;/b&gt; to move focus.&#10;Single keys only work in the&#10;file viewer. See page 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#eb6f92;fontColor=#575279;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="oops">
          <mxGeometry x="1120" y="50" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="Everything above is keyboard only. The mouse works too (click the sidebar, drag pane borders) but nothing requires it." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#575279;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="400" y="950" width="800" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
